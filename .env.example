# CodeMedic Configuration
# Copy this file to .env and fill in your settings.

# OpenAI-compatible API configuration (OpenCode)
# Fill in your OpenCode API endpoint and key here:
OPENAI_API_KEY=your-opencode-api-key
OPENAI_API_BASE=https://opencode.ai/zen/go/v1
OPENAI_MODEL_NAME=deepseek-v4-flash

# Test execution backend. Keep temporary unless Docker is available and the image is built.
EXECUTION_BACKEND=temporary
DOCKER_IMAGE=codemedic-runner:local
DOCKER_TIMEOUT_SECONDS=120
DOCKER_MEMORY_LIMIT=512m
DOCKER_CPU_LIMIT=1.0
DOCKER_PIDS_LIMIT=128

# LangSmith (optional - uncomment to enable tracing)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls-your-api-key
# LANGCHAIN_PROJECT=codemedic
